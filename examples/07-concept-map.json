          "title": "How the signals are used in practice",
          "items": [
            {
              "label": "Alert fires",
              "text": "metric breaches SLO",
              "detail": "Error rate above 1% for 5 minutes on one endpoint."
            },
            {
              "label": "Open the trace",
              "text": "which service was slow",
              "detail": "Via the trace id of failed requests in that window."
            },
            {
              "label": "Read the logs",
              "text": "what happened there",
              "detail": "Filtered by the same trace id."
            },
            {
              "label": "Fix and measure",
              "text": "the metric recovers",
              "detail": "Closes the loop: the same metric confirms the fix."
            }
          ]
