        { "type": "chart", "id": "t2", "title": "Novos por canal (mil)", "kind": "stackedBar", "height": 200,
          "x": { "type": "category" }, "y": { "min": 0 },
          "series": [
            { "name": "Orgânico", "data": [["T1", 3.1], ["T2", 3.6], ["T3", 5.2], ["T4", 5.9]] },
            { "name": "Indicação", "data": [["T1", 1.2], ["T2", 1.5], ["T3", 2.8], ["T4", 3.1]] },
