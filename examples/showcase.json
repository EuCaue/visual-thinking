    {
      "id": "numbers", "title": "Números", "layout": { "type": "stack", "gap": 40 },
      "summary": "\"Qual desses valores é maior?\" Barras ordenadas com o valor escrito. Nada mais.",
      "blocks": [
        { "type": "chart", "id": "n", "title": "Latência p95 por região (ms)", "kind": "bar", "height": 200, "marks": ["bar", "label"], "width": 520,
