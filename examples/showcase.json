    {
      "id": "arch", "title": "Arquitetura", "layout": { "type": "stack", "gap": 36 },
      "summary": "\"Mostre uma arquitetura com frontend, API, Redis e PostgreSQL.\" Componentes com responsabilidade, fronteiras por processo, arestas rotuladas pelo que transportam.",
      "blocks": [
        { "type": "graph", "id": "g", "direction": "RIGHT",
          "groups": [ { "id": "api", "label": "Processo API" } ],
          "nodes": [
            { "id": "web", "label": "Frontend", "sub": "SPA, chama a API com JWT", "kind": "external" },
            { "id": "gw", "label": "POST /orders", "sub": "valida e grava o pedido", "kind": "entry", "group": "api" },
            { "id": "cache", "label": "Cache de catálogo", "sub": "lê preços do Redis", "kind": "component", "group": "api" },
            { "id": "redis", "label": "Redis", "sub": "cache e fila", "kind": "queue" },
            { "id": "pg", "label": "PostgreSQL", "sub": "pedidos, usuários", "kind": "store" },
            { "id": "wk", "label": "Worker", "sub": "envia confirmação por email", "kind": "component" } ],
          "edges": [
            { "from": "web", "to": "gw", "label": "POST /orders", "kind": "control" },
            { "from": "gw", "to": "cache", "label": "preço por SKU", "kind": "control" },
            { "from": "cache", "to": "redis", "label": "GET sku:*", "kind": "data" },
            { "from": "gw", "to": "pg", "label": "INSERT orders", "kind": "data" },
            { "from": "gw", "to": "redis", "label": "job email", "kind": "event" },
            { "from": "redis", "to": "wk", "label": "consome", "kind": "event" },
            { "from": "wk", "to": "pg", "label": "lê pedido", "kind": "data" } ] },
        { "type": "callout", "id": "a2", "kind": "warn", "text": "Redis acumula dois papéis, cache e fila. Uma queda derruba leitura de preço e envio de email ao mesmo tempo." }
      ]
    },
    {
      "id": "timeline", "title": "Timeline", "layout": { "type": "stack", "gap": 40 },
      "summary": "\"Faça uma timeline da história do projeto.\" Eventos em ordem, marcos maiores, períodos como faixas.",
      "blocks": [
        { "type": "timeline", "id": "tl", "title": "Do protótipo ao lançamento", "orientation": "horizontal",
          "periods": [ { "from": "2024-02", "to": "2024-09", "label": "beta fechado" } ],
          "events": [
            { "date": "2023-11", "title": "Protótipo", "text": "três telas, sem backend" },
            { "date": "2024-02", "title": "Beta fechado", "text": "40 contas convidadas", "kind": "milestone" },
            { "date": "2024-05", "title": "Troca de banco", "text": "SQLite para Postgres" },
            { "date": "2024-09", "title": "Beta aberto", "text": "cadastro livre", "kind": "milestone" },
            { "date": "2025-01", "title": "Plano pago", "text": "primeira receita" },
            { "date": "2025-06", "title": "v1.0", "text": "SLA publicado", "kind": "milestone" } ] },
        { "type": "steps", "id": "st", "title": "Pipeline de release", "items": [
          { "title": "Build", "text": "testes e lint em cada PR" }, { "title": "Staging", "text": "deploy automático do main" }, { "title": "Canário", "text": "5% do tráfego por 1h", "kind": "accent" }, { "title": "Produção", "text": "rollout completo" } ] }
      ]
    },
    {
      "id": "proscons", "title": "Prós e contras", "layout": { "type": "stack", "gap": 40 },
      "summary": "\"Mostre as vantagens e desvantagens dessas duas soluções.\" Colunas alinhadas, mesmos critérios, sinais + e − legíveis sem cor.",
      "blocks": [
        { "type": "cards", "id": "pc", "title": "Monólito modular ou microsserviços", "cardWidth": 260, "items": [
          { "title": "Monólito modular", "meta": "um deploy, módulos com fronteiras", "points": [
            { "kind": "pro", "text": "Um pipeline, um banco, uma transação" }, { "kind": "pro", "text": "Refatorar fronteiras é barato" }, { "kind": "pro", "text": "Latência interna zero" },
            { "kind": "con", "text": "Escala tudo junto" }, { "kind": "con", "text": "Um bug de memória derruba tudo" } ] },
          { "title": "Microsserviços", "meta": "n deploys, contratos por rede", "points": [
            { "kind": "pro", "text": "Escala e deploy por serviço" }, { "kind": "pro", "text": "Times donos de serviços" },
            { "kind": "con", "text": "Transações distribuídas" }, { "kind": "con", "text": "Observabilidade obrigatória desde o dia 1" }, { "kind": "con", "text": "Custo fixo de infraestrutura" } ] } ] },
        { "type": "spectrum", "id": "sp", "title": "Onde cada opção faz sentido", "min": "time de 3 pessoas", "max": "20 times", "items": [
          { "label": "monólito modular", "value": 0.2 }, { "label": "monólito + 1 ou 2 serviços", "value": 0.5 }, { "label": "microsserviços", "value": 0.85 } ] }
      ]
    },
    {
      "id": "concept", "title": "Conceito", "layout": { "type": "stack", "gap": 40 },
      "summary": "\"Explique Kubernetes.\" Hierarquia de conceitos como árvore, e o ciclo de reconciliação como ciclo, porque é isso que ele é.",
      "blocks": [
        { "type": "tree", "id": "k8s", "title": "O que há dentro de um cluster", "direction": "DOWN",
          "root": { "label": "Cluster", "children": [
            { "label": "Control plane", "children": [ { "label": "API server" }, { "label": "etcd", "kind": "store" }, { "label": "Scheduler" }, { "label": "Controllers" } ] },
            { "label": "Nodes", "children": [ { "label": "kubelet" }, { "label": "Pods", "children": [ { "label": "Containers" } ] }, { "label": "kube-proxy" } ] } ] } },
        { "type": "cycle", "id": "loop", "title": "Loop de reconciliação", "items": [
          { "label": "Estado desejado", "text": "você declara (YAML)" }, { "label": "Observar", "text": "controller lê o estado atual" }, { "label": "Comparar", "text": "diff desejado vs. atual" }, { "label": "Agir", "text": "cria, mata, reagenda" } ] }
      ]
    },
    {
      "id": "position", "title": "Posição e proporção", "layout": { "type": "row", "gap": 56 },
      "summary": "\"Mostre onde essas tecnologias se encaixam\" e \"qual a fatia de cada uma\". Posição pede dois eixos; proporção de poucas partes pede um anel.",
