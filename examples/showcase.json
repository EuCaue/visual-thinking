        { "type": "chart", "id": "share", "title": "Tráfego por origem", "kind": "donut", "width": 260, "height": 260, "y": { "label": "visitas/dia" },
          "series": [ { "name": "origem", "data": [["Busca", 5400], ["Direto", 2100], ["Social", 1300], ["Email", 700]] } ] }
