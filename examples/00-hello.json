            },
            {
              "id": "db",
              "label": "Postgres",
              "sub": "orders table",
              "kind": "store"
            }
          ],
          "edges": [
            {
              "from": "web",
              "to": "api",
              "label": "POST /orders",
              "main": true
            },
            {
              "from": "api",
              "to": "pay",
              "label": "charge"
            },
            {
              "from": "api",
              "to": "db",
