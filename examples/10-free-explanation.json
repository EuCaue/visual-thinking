        },
        {
          "type": "steps",
          "id": "s",
          "title": "What lets the edge answer on its own",
          "stepWidth": 180,
          "items": [
            {
              "title": "Has a copy?",
              "text": "URL and Vary keys match",
              "kind": "decision"
            },
            {
              "title": "Still fresh?",
              "text": "age < max-age, or revalidate with ETag",
              "kind": "decision"
            },
            {
              "title": "Serve from edge",
              "text": "HIT, local network latency",
              "kind": "ok"
            },
            {
              "title": "Otherwise, fetch from origin",
              "text": "MISS, store the new response",
              "kind": "warn"
            }
          ]
        },
        {
          "type": "callout",
          "id": "c",
          "kind": "note",
          "text": "Purging the URL resets the edge TTL without waiting 600 s; that's how a deploy drops the old copy early."
        }
      ],
      "annotations": [
        "Latencies are typical SP ↔ Virginia values; real numbers depend on provider and time of day.",
        "stale-while-revalidate serves the stale copy while fetching a new one; left out of the diagram for simplicity."
